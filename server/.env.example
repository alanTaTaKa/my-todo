# PostgreSQL 连接串（Neon / Supabase / 本地均可）
DATABASE_URL=postgresql://user:password@localhost:5432/daily_calm

# 迁移专用直连接（Neon 等连接池环境必填，本地可留空回退到 DATABASE_URL）
# DATABASE_URL_DIRECT=postgresql://user:password@host/daily_calm?sslmode=require

# 服务监听端口
PORT=8787

# development | production
NODE_ENV=development

# 允许携带 Cookie 的前端来源（开发时 Vite 代理为同源，此值仍用于直连调试）
APP_ORIGIN=http://localhost:5173

# 会话 Cookie 的 SameSite：Lax | Strict | None
# 默认 Lax（配合 Vercel 同源代理最安全）；仅当前后端跨站直连（不同站点域名）时才设为 None（需 HTTPS）
# COOKIE_SAME_SITE=None

# 会话有效期（天）
SESSION_TTL_DAYS=30

# 解锁升级版（Pro）的兑换码，逗号分隔；用于手动发码 / 内测解锁
# REDEEM_CODES=DAILY-CALM-DEMO,ANOTHER-CODE
